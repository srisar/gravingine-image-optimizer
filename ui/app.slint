// Gravingine Image Optimizer: the whole window, built on Slint's Cosmic widget style.
// Colors come from the style's Palette (which follows Windows' light/dark mode and tints its
// accent from the Windows accent color); icons are glyphs from the Windows icon font.

import { AboutSlint, CheckBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, Slider, Spinner, Switch } from "std-widgets.slint";

export global Ui {
    // "Segoe Fluent Icons" on Windows 11, "Segoe MDL2 Assets" on Windows 10 (set from Rust).
    in property <string> icon-font: "Segoe Fluent Icons";
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> secondary: Palette.foreground.with-alpha(0.68);
    out property <brush> tertiary: Palette.foreground.with-alpha(0.48);
    out property <brush> card: Palette.alternate-background;
    out property <brush> card-border: Palette.border;
    out property <brush> tint: Palette.accent-background.with-alpha(dark ? 0.20 : 0.14);
    out property <color> success: dark ? #6CCB5F : #0F7B0F;
    out property <color> caution: dark ? #FCE100 : #9D5D00;
    out property <color> critical: dark ? #FF99A4 : #C42B1C;
}

// Glyphs shared by Segoe Fluent Icons and Segoe MDL2 Assets.
export global Glyph {
    out property <string> add-files: "\u{E8E5}";
    out property <string> add-folder: "\u{E8F4}";
    out property <string> clear: "\u{E74D}";
    out property <string> optimize: "\u{E945}";
    out property <string> cancel: "\u{E711}";
    out property <string> open-folder: "\u{ED25}";
    out property <string> browse: "\u{E8DA}";
    out property <string> photo: "\u{EB9F}";
    out property <string> drop: "\u{E898}";
    out property <string> done: "\u{E73E}";
    out property <string> running: "\u{E895}";
    out property <string> skipped: "\u{E7BA}";
    out property <string> error: "\u{EA39}";
    out property <string> select-all: "\u{E8B3}";
    out property <string> select-none: "\u{E8E6}";
    out property <string> webp: "\u{E774}";
    out property <string> avif: "\u{E734}";
    out property <string> jpeg: "\u{EB9F}";
    out property <string> png: "\u{E790}";
    out property <string> resize: "\u{E740}";
    out property <string> save: "\u{E74E}";
    out property <string> compare: "\u{E890}";
    out property <string> chevron-left: "\u{E76B}";
    out property <string> chevron-right: "\u{E76C}";
    out property <string> info: "\u{E946}";
    out property <string> open-new: "\u{E8A7}";
    out property <string> preset: "\u{E9E9}";
    out property <string> target: "\u{ED5E}";
    out property <string> tag: "\u{E8EC}";
    out property <string> tip: "\u{E82F}";
    out property <string> warning: "\u{E7BA}";
}

// One image in the list. tone: 0 normal, 1 success, 2 caution, 3 critical.
// badge: 0 none, 1 done, 2 running, 3 skipped, 4 error.
export struct TileData {
    name: string,
    details: string,
    output: string,
    location: string,
    tone: int,
    badge: int,
    running: bool,
    selected: bool,
    thumb: image,
    has-thumb: bool,
    // Original / Output columns. out-resized: the output is smaller than the original
    // (accent color). out-tone: 0 not yet, 1 saved, 2 skipped, 3 failed.
    orig-dims: string,
    orig-size: string,
    out-dims: string,
    out-resized: bool,
    out-size: string,
    out-tone: int,
    // Readable: the eye button opens a live preview (or, once optimized, the saved outputs).
    can-compare: bool,
}

// One output format in the comparison view's chips.
export struct CompareFormat {
    label: string,
    detail: string,
}

component Icon inherits Text {
    in property <string> glyph;
    text: root.glyph;
    font-family: Ui.icon-font;
    font-size: 16px;
    color: Palette.foreground;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

// A Cosmic-looking button with an icon-font glyph before its text.
component GlyphButton {
    in property <string> glyph;
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    private property <brush> fg: root.primary ? Palette.accent-foreground : Palette.control-foreground;

    min-height: 34px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    background := Rectangle {
        border-radius: 17px;
        background: root.primary ? Palette.accent-background : Palette.control-background;
        animate background { duration: 150ms; }

        HorizontalLayout {
            padding-left: root.text == "" ? 9px : root.glyph == "" ? 18px : 14px;
            padding-right: root.text == "" ? 9px : root.glyph == "" ? 18px : 16px;
            spacing: 8px;
            alignment: center;
            if root.glyph != "": Icon {
                glyph: root.glyph;
                color: root.fg;
                font-size: 15px;
            }
            if root.text != "": Text {
                text: root.text;
                color: root.fg;
                font-weight: root.primary ? 600 : 400;
                vertical-alignment: center;
            }
        }
    }

    overlay := Rectangle {
        border-radius: background.border-radius;
        background: touch.pressed ? #00000030 : touch.has-hover ? #63636333 : transparent;
        animate background { duration: 100ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionHeading inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Palette.foreground;
}

// A setting card: tinted icon tile, title, description and a switch. Its contents slide
// open below a divider while it is switched on.
component SettingCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    // Cards without a switch (e.g. "Save to") are always open.
    in property <bool> switchable: true;
    // Left inset of the card contents (level with the icon tile by default).
    in property <length> indent: 12px;
    // A link after the description ("How it works"), when set.
    in property <string> more;
    in-out property <bool> on: true;
    callback toggled;
    callback more-clicked;

    private property <bool> open: !root.switchable || root.on;

    background: Ui.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Ui.card-border;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 9px;
                background: Ui.tint;
                Icon {
                    glyph: root.glyph;
                    color: Palette.accent-background;
                    font-size: 18px;
                }
            }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                    overflow: elide;
                }
                if root.description != "": HorizontalLayout {
                    Text {
                        text: root.description;
                        font-size: 12px;
                        color: Ui.secondary;
                        overflow: elide;
                    }
                    if root.more != "": Text {
                        text: " · ";
                        font-size: 12px;
                        color: Ui.secondary;
                    }
                    if root.more != "": Rectangle {
                        width: link.preferred-width;
                        accessible-role: button;
                        accessible-label: root.more;
                        accessible-action-default => { root.more-clicked(); }
                        link := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.more;
                            font-size: 12px;
                            color: link-touch.has-hover ? Palette.accent-background.brighter(0.25) : Palette.accent-background;
                            accessible-role: none;
                        }
                        link-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.more-clicked(); }
                        }
                    }
                    // Keeps the description and link together on the left.
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.switchable: VerticalLayout {
                alignment: center;
                Switch {
                    checked <=> root.on;
                    enabled: root.enabled;
                    accessible-label: root.title;
                    toggled => { root.toggled(); }
                }
            }
        }
        body := Rectangle {
            height: root.open ? inner.preferred-height : 0px;
            clip: true;
            animate height { duration: 180ms; easing: ease-in-out; }
            inner := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                Rectangle {
                    height: 1px;
                    background: Ui.card-border;
                }
                VerticalLayout {
                    padding-left: root.indent;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

component SliderRow {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // Shown after the value, e.g. "%" for quality.
    in property <string> unit;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback changed;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            width: 56px;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Ui.tertiary;
        }
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: 1;
            value <=> root.value;
            enabled: root.enabled;
            changed(v) => { root.changed(); }
        }
        Text {
            text: Math.round(root.value) + root.unit;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Ui.tertiary;
        }
    }
}

component SwitchRow {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled;

    HorizontalLayout {
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Ui.tertiary;
        }
        Switch {
            checked <=> root.checked;
            enabled: root.enabled;
            accessible-label: root.label;
            toggled => { root.toggled(); }
        }
    }
}

component NumberRow {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <string> value;
    callback edited;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Ui.tertiary;
        }
        LineEdit {
            width: 96px;
            text <=> root.value;
            enabled: root.enabled;
            input-type: number;
            horizontal-alignment: right;
            edited => { root.edited(); }
        }
    }
}

// A drop-down list of choices that looks and behaves like the style's ComboBox, except that
// its list is as wide as the longest choice when that is wider than the box (it grows to the
// left). The style's list is always exactly as wide as its box, which cuts off longer choices
// and leaves a narrow box ("KB") nothing but "…".
component DropDown {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "";
    callback selected(string);

    private property <length> item-height: 40px;
    private property <length> list-padding: 4px;
    private property <int> visible-items: min(6, root.model.length);
    private property <bool> list-open;
    // Item: 16px padding, the text, 8px spacing, the 16px check mark, 16px padding.
    private property <length> list-width: max(root.width, measure.preferred-width + 56px + 2 * root.list-padding + 2px);
    private property <brush> hover: #63636333;
    private property <brush> pressed-bg: Ui.dark ? #16161680 : #BEBEBE80;
    private property <brush> selected-bg: Ui.dark ? #4D4D4D4D : #98989833;

    min-width: max(160px, box-layout.min-width);
    min-height: max(32px, box-layout.min-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.list-open;
    accessible-value: root.current-value;
    accessible-action-expand => { root.open(); }

    function choose(index: int) {
        if (!root.enabled || index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        root.selected(root.current-value);
    }

    function open() {
        if (root.enabled) {
            list.show();
        }
    }

    // The longest choice, measured (never drawn).
    measure := VerticalLayout {
        width: 0;
        height: 0;
        visible: false;
        for value in root.model: Text { text: value; }
    }

    box := Rectangle {
        border-radius: 16px;
        background: Palette.control-background;
        border-width: 1px;
        border-color: Palette.border;

        box-layout := HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Palette.control-foreground;
                text: root.current-value;
                overflow: elide;
                accessible-role: none;
            }
            Path {
                width: 16px;
                height: 16px;
                cross-axis-self-alignment: center;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M13 6L8 11L3 6H13Z";
                fill: Palette.control-foreground;
                accessible-role: none;
            }
        }

        Rectangle {
            border-radius: box.border-radius;
            background: touch.pressed ? root.pressed-bg : touch.has-hover ? root.hover : transparent;
        }
        if (focus.has-focus || root.list-open) && root.enabled: Rectangle {
            width: box.width + 6px;
            height: box.height + 6px;
            border-width: 1px;
            border-radius: box.border-radius + 3px;
            border-color: Palette.accent-background;
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.choose(max(root.current-index - 1, 0));
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.choose(min(root.current-index + 1, root.model.length - 1));
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.open();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                focus.focus();
                root.open();
            }
        }
    }

    list := PopupWindow {
        x: root.width - root.list-width;
        y: root.height + 4px;
        width: root.list-width;
        height: root.visible-items * root.item-height + 2 * root.list-padding;
        close-policy: close-on-click-outside;
        forward-focus: list-focus;

        list-focus := FocusScope {
            focus-changed-event => {
                root.list-open = self.has-focus;
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.choose(max(root.current-index - 1, 0));
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.choose(min(root.current-index + 1, root.model.length - 1));
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Escape) {
                    list.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                border-radius: 8px;
                background: Palette.alternate-background;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: Ui.dark ? #00000052 : #00000014;

                Rectangle {
                    border-width: 1px;
                    border-radius: parent.border-radius;
                    border-color: Ui.dark ? #DEDEDE33 : #3D3D3D33;
                }

                ScrollView {
                    // Scrolled so the chosen item shows.
                    content-y: -max(0, root.current-index - root.visible-items + 1) * root.item-height;
                    VerticalLayout {
                        alignment: start;
                        padding: root.list-padding;
                        for value[index] in root.model: entry := Rectangle {
                            property <bool> chosen: index == root.current-index;
                            height: root.item-height;
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-item-selectable: true;
                            accessible-item-selected: self.chosen;
                            accessible-item-index: index;

                            // Like the style's list items: a 32px pill with 8px below it.
                            Rectangle {
                                y: 0;
                                height: parent.height - 8px;
                                border-radius: 16px;
                                background: item-touch.pressed ? root.pressed-bg
                                    : item-touch.has-hover ? root.hover
                                    : entry.chosen ? root.selected-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    item-text := Text {
                                        text: value;
                                        color: entry.chosen ? Palette.accent-background : Palette.control-foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        accessible-role: none;
                                    }
                                    Path {
                                        width: 16px;
                                        height: 16px;
                                        cross-axis-self-alignment: center;
                                        viewbox-width: 16;
                                        viewbox-height: 16;
                                        commands: "M12.8406 3.008C12.6197 3.05641 12.4215 3.17755 12.2776 3.352L5.99762 10.539L3.74762 8.28901C3.37062 7.91301 2.68561 7.91301 2.30961 8.28901C1.93261 8.66601 1.93261 9.35 2.30961 9.727L5.30961 12.727L6.09061 13.477L6.77863 12.664L13.7786 4.664C14.3456 4.047 13.6626 2.84 12.8406 3.008Z";
                                        fill: item-text.color;
                                        visible: entry.chosen;
                                        accessible-role: none;
                                    }
                                }
                            }
                            item-touch := TouchArea {
                                clicked => {
                                    root.choose(index);
                                    list.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Help text for a setting: the text on a soft panel, after a lightbulb in an accent chip
// (like the cards' icon tiles). A warning only swaps the lightbulb for a warning sign: it's
// there to be read, not to alarm.
component Hint inherits Rectangle {
    in property <string> text;
    in property <bool> warning;

    border-radius: 8px;
    background: Palette.foreground.with-alpha(0.05);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding: 8px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                background: Ui.tint;
                Icon {
                    glyph: root.warning ? Glyph.warning : Glyph.tip;
                    color: Palette.accent-background;
                    font-size: 12px;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            color: Ui.secondary;
            wrap: word-wrap;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A label and a drop-down list of choices.
component ChoiceRow {
    in property <string> label;
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    callback selected;

    HorizontalLayout {
        spacing: 8px;
        Text {
            width: 96px;
            text: root.label;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Ui.tertiary;
        }
        DropDown {
            horizontal-stretch: 1;
            model: root.model;
            current-index <=> root.current-index;
            enabled: root.enabled;
            accessible-label: root.label;
            selected => { root.selected(); }
        }
    }
}

// One image: checkbox, thumbnail with a status badge, name and three lines of details.
// A right-aligned figure in a tile's Original / Output columns.
// role: 0 column label, 1 dimensions, 2 file size.
component TileFigure inherits Text {
    in property <int> role;
    width: 104px;
    horizontal-alignment: right;
    font-size: root.role == 1 ? 15px : root.role == 0 ? 11px : 12px;
    font-weight: root.role == 1 ? 600 : 400;
    color: root.role == 0 ? Ui.tertiary : root.role == 1 ? Palette.foreground : Ui.secondary;
    overflow: elide;
}

component Tile inherits Rectangle {
    in property <TileData> data;
    in property <bool> enabled: true;
    callback toggled(bool);
    callback compare;

    private property <color> tone-color: data.tone == 1 ? Ui.success : data.tone == 2 ? Ui.caution : data.tone == 3 ? Ui.critical : Palette.foreground;

    height: 92px;
    border-radius: 10px;
    background: touch.has-hover ? Palette.control-background : transparent;
    animate background { duration: 120ms; }
    opacity: data.selected || data.running ? 1 : 0.62;

    HorizontalLayout {
        padding: 10px;
        padding-left: 8px;
        spacing: 12px;
        check-cell := VerticalLayout {
            alignment: center;
            CheckBox {
                checked: data.selected;
                enabled: root.enabled;
                accessible-label: data.name;
                toggled => { root.toggled(self.checked); }
            }
        }
        VerticalLayout {
            alignment: center;
        Rectangle {
            width: 72px;
            height: 72px;
            thumb := Rectangle {
                border-radius: 8px;
                clip: true;
                background: Ui.tint;
                if data.has-thumb: Image {
                    width: 100%;
                    height: 100%;
                    source: data.thumb;
                    image-fit: cover;
                }
                if !data.has-thumb: Icon {
                    glyph: Glyph.photo;
                    color: Palette.accent-background;
                    font-size: 26px;
                }
            }
            if data.badge != 0: Rectangle {
                x: parent.width - self.width + 5px;
                y: parent.height - self.height + 5px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Ui.card;
                border-width: 1px;
                border-color: Ui.card-border;
                Icon {
                    glyph: data.badge == 1 ? Glyph.done : data.badge == 2 ? Glyph.running : data.badge == 3 ? Glyph.skipped : Glyph.error;
                    color: data.badge == 2 ? Palette.accent-background : root.tone-color;
                    font-size: 13px;
                }
            }
        }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: data.name;
                font-size: 14px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: data.details;
                font-size: 12px;
                color: Ui.secondary;
                overflow: elide;
            }
            if !data.running: Text {
                text: data.output;
                font-size: 12px;
                color: data.tone == 0 ? Palette.foreground : root.tone-color;
                overflow: elide;
            }
            if data.running: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 5px;
                padding-right: 40px;
                ProgressIndicator {
                    height: 4px;
                    indeterminate: true;
                }
            }
            Text {
                text: data.location;
                font-size: 12px;
                color: data.tone == 3 ? Ui.critical : Ui.tertiary;
                overflow: elide;
            }
        }
        // Original / Output: dimensions and file size, in fixed-width columns so they line
        // up from tile to tile.
        VerticalLayout {
            alignment: center;
            padding-right: 6px;
            GridLayout {
                spacing-horizontal: 16px;
                spacing-vertical: 1px;
                Row {
                    TileFigure { text: "Original"; role: 0; }
                    TileFigure { text: "Output"; role: 0; }
                }
                Row {
                    TileFigure { text: data.orig-dims; role: 1; }
                    TileFigure {
                        text: data.out-dims;
                        role: 1;
                        color: data.out-resized ? Palette.accent-background : Ui.tertiary;
                    }
                }
                Row {
                    TileFigure { text: data.orig-size; role: 2; }
                    TileFigure {
                        text: data.out-size;
                        role: 2;
                        color: data.out-tone == 1 ? Ui.success : data.out-tone == 2 ? Ui.caution : data.out-tone == 3 ? Ui.critical : Ui.tertiary;
                    }
                }
            }
        }
        // Room for the Compare button (placed above the click area below), so the columns
        // line up whether or not a tile has one.
        compare-slot := Rectangle {
            width: 40px;
        }
    }

    // On top of everything: clicking the tile opens the before / after view...
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: data.can-compare ? pointer : default;
        clicked => {
            if (data.can-compare) {
                root.compare();
            }
        }
    }

    // ...and clicking the checkbox column (full tile height, so it's easy to hit) ticks or
    // unticks it. The checkbox itself only shows the state, so it always follows the model
    // (e.g. Select all).
    TouchArea {
        x: 0px;
        width: check-cell.x + check-cell.width + 6px;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!data.selected); }
    }

    if data.can-compare: GlyphButton {
        x: compare-slot.x + (compare-slot.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        glyph: Glyph.compare;
        enabled: root.enabled;
        accessible-label: "Preview and compare with the original";
        clicked => { root.compare(); }
    }
}

// A small pill toggle (format and zoom choices in the comparison view).
component Chip {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 28px;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Rectangle {
        border-radius: 14px;
        background: root.on ? Ui.tint : touch.has-hover ? Palette.control-background : transparent;
        border-width: 1px;
        border-color: root.on ? Palette.accent-background : Ui.card-border;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: root.text;
                font-size: 12px;
                vertical-alignment: center;
                color: root.on ? Palette.accent-background : Palette.foreground;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StageLabel inherits Rectangle {
    in property <string> text;
    height: 22px;
    width: label.preferred-width + 18px;
    border-radius: 11px;
    background: Ui.card;
    border-width: 1px;
    border-color: Ui.card-border;
    label := Text {
        text: root.text;
        font-size: 11px;
        color: Ui.secondary;
    }
}

// Before / after: the original on the left of a draggable split line, the output on the
// right, both drawn at the same size so quality (not dimensions) is what's compared.
component CompareView inherits Rectangle {
    in property <string> name;
    in property <[CompareFormat]> formats;
    in property <int> current;
    in property <image> original;
    in property <image> output;
    // Pixel size of the original; the output is stretched over the same area.
    in property <int> image-width;
    in property <int> image-height;
    in property <string> output-label;
    // Footer: "317.7 KB" / "1200 × 900" for each side, "WebP at 60% · not saved yet" over
    // the output, and the saving between ("−72%", "saves 229.4 KB").
    in property <string> original-size;
    in property <string> original-dims;
    in property <string> output-caption;
    in property <string> output-size;
    in property <string> output-dims;
    in property <string> saving;
    in property <string> saving-detail;
    // Output size color: 0 neutral, 1 smaller (success), 2 larger (caution).
    in property <int> output-tone;
    private property <color> tone-color: root.output-tone == 1 ? Ui.success : root.output-tone == 2 ? Ui.caution : Palette.foreground;
    // Shown at the bottom of the picture while something is being decoded or encoded.
    in property <string> busy;
    // Shown in the middle when there's nothing to compare.
    in property <string> message;
    // Live preview of the current settings rather than the saved outputs.
    in property <bool> preview;
    // The image has saved outputs, so it can switch between Saved and Preview.
    in property <bool> has-saved;
    // 0 fits the stage; otherwise original pixels per screen pixel (1 = 100%). When the
    // picture is bigger than the stage, dragging pans it.
    in-out property <float> zoom;
    private property <[float]> zoom-levels: [0, 0.25, 0.5, 0.75, 1];
    // Split line position across the visible stage, 0 (left) to 1 (right).
    in-out property <float> split: 0.5;
    callback select(int);
    callback set-preview(bool);
    callback close;

    background: Ui.card;

    // Clicks and wheel turns on empty parts of the view must not reach the list below.
    TouchArea {
        scroll-event(e) => { accept }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
    }
    init => { keys.focus(); }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.name;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            // Saved outputs, or a live preview of the current settings (images that have been
            // optimized can show either).
            if root.has-saved: VerticalLayout {
                alignment: center;
                Chip {
                    text: "Saved";
                    on: !root.preview;
                    clicked => { root.set-preview(false); }
                }
            }
            if root.has-saved: VerticalLayout {
                alignment: center;
                Chip {
                    text: "Preview";
                    on: root.preview;
                    clicked => { root.set-preview(true); }
                }
            }
            Rectangle { width: 8px; }
            for level in root.zoom-levels: VerticalLayout {
                alignment: center;
                Chip {
                    text: level == 0 ? "Fit" : Math.round(level * 100) + "%";
                    on: root.zoom == level;
                    clicked => { root.zoom = level; }
                }
            }
            Rectangle { width: 4px; }
            GlyphButton {
                glyph: Glyph.cancel;
                accessible-label: "Close comparison";
                clicked => { root.close(); }
            }
        }

        // The output formats on show (saved, or what the settings would produce).
        if root.formats.length > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for format[i] in root.formats: Chip {
                text: format.detail == "" ? format.label : format.label + " " + format.detail;
                on: i == root.current;
                clicked => { root.select(i); }
            }
        }

        stage := Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: Palette.background;
            clip: true;

            property <length> natural-w: root.image-width * 1phx;
            property <length> natural-h: root.image-height * 1phx;
            property <float> fit: root.image-width == 0 || root.image-height == 0 ? 1 : min(self.width / self.natural-w, self.height / self.natural-h);
            property <float> scale: root.zoom == 0 ? self.fit : root.zoom;
            property <length> shown-w: self.natural-w * self.scale;
            property <length> shown-h: self.natural-h * self.scale;
            // Bigger than the stage: dragging pans (and only the line's handle moves the line).
            property <bool> pannable: self.shown-w > self.width + 0.5px || self.shown-h > self.height + 0.5px;
            property <length> split-x: self.width * root.split;

            flick := Flickable {
                content-width: max(stage.width, stage.shown-w);
                content-height: max(stage.height, stage.shown-h);
                interactive: stage.pannable;

                picture := Rectangle {
                    x: max(0px, (flick.width - stage.shown-w) / 2);
                    y: max(0px, (flick.height - stage.shown-h) / 2);
                    width: stage.shown-w;
                    height: stage.shown-h;
                    // Where the split line falls inside the picture.
                    property <length> cut: clamp(stage.split-x - flick.content-x - self.x, 0px, self.width);

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.original;
                        image-fit: fill;
                    }
                    Rectangle {
                        x: picture.cut;
                        width: picture.width - picture.cut;
                        height: 100%;
                        clip: true;
                        Image {
                            x: -picture.cut;
                            width: picture.width;
                            height: picture.height;
                            source: root.output;
                            image-fit: fill;
                        }
                    }
                }
            }

            // The split line and its handle.
            Rectangle {
                x: stage.split-x - 1px;
                width: 2px;
                background: Palette.accent-background;
            }
            Rectangle {
                x: stage.split-x - self.width / 2;
                y: (stage.height - self.height) / 2;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: Palette.accent-background;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        glyph: Glyph.chevron-left;
                        font-size: 10px;
                        color: Palette.accent-foreground;
                    }
                    Icon {
                        glyph: Glyph.chevron-right;
                        font-size: 10px;
                        color: Palette.accent-foreground;
                    }
                }
            }
            // When the whole picture is visible, drag anywhere to move the line. When it's
            // bigger than the stage, drag the line itself; dragging elsewhere pans.
            drag := TouchArea {
                x: stage.pannable ? stage.split-x - 16px : 0px;
                width: stage.pannable ? 32px : stage.width;
                mouse-cursor: ew-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.split = clamp((self.x + self.mouse-x) / stage.width, 0, 1);
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.split = clamp((self.x + self.mouse-x) / stage.width, 0, 1);
                    }
                }
            }

            StageLabel {
                x: 10px;
                y: 10px;
                text: "Original";
            }
            StageLabel {
                x: stage.width - self.width - 10px;
                y: 10px;
                text: root.output-label;
            }

            // A message from the last result gives way while the next one is being made.
            if root.message != "" && root.busy == "": Rectangle {
                width: msg.preferred-width + 28px;
                height: 34px;
                border-radius: 17px;
                background: Ui.card;
                msg := Text {
                    text: root.message;
                    color: Ui.secondary;
                }
            }
            // "Loading…" / "Updating preview…": centered on the picture, with a spinner and a
            // shadow so it reads over any image.
            if root.busy != "": Rectangle {
                width: busy-row.preferred-width;
                height: 52px;
                border-radius: 26px;
                background: Ui.card;
                border-width: 1px;
                border-color: Ui.card-border;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000059;
                busy-row := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 22px;
                    spacing: 12px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Spinner {
                            indeterminate: true;
                            width: 26px;
                            height: 26px;
                        }
                    }
                    Text {
                        text: root.busy;
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Sizes: the original under the original's side of the split, the output under the
        // output's side, and what it saves in between.
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "Original";
                    font-size: 11px;
                    color: Ui.tertiary;
                }
                Text {
                    text: root.original-size;
                    font-size: 20px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                Text {
                    text: root.original-dims;
                    font-size: 12px;
                    color: Ui.secondary;
                }
            }
            if root.saving != "": VerticalLayout {
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        width: badge.preferred-width + 22px;
                        border-radius: 13px;
                        background: root.tone-color.with-alpha(Ui.dark ? 0.18 : 0.12);
                        badge := Text {
                            text: root.saving;
                            font-size: 13px;
                            font-weight: 600;
                            color: root.tone-color;
                        }
                    }
                }
                Text {
                    text: root.saving-detail;
                    font-size: 11px;
                    color: Ui.tertiary;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.output-caption;
                    font-size: 11px;
                    color: Ui.tertiary;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    text: root.output-size;
                    font-size: 20px;
                    font-weight: 600;
                    color: root.tone-color;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.output-dims;
                    font-size: 12px;
                    color: Ui.secondary;
                    horizontal-alignment: right;
                }
            }
        }
    }
}

// A link to a web page: accent text with an "open in new window" mark, brighter on hover.
component Link {
    in property <string> text;
    callback clicked;

    private property <brush> color: touch.has-hover ? Palette.accent-background.brighter(0.25) : Palette.accent-background;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        spacing: 5px;
        Text {
            text: root.text;
            font-size: 13px;
            color: root.color;
            vertical-alignment: center;
        }
        Icon {
            glyph: Glyph.open-new;
            font-size: 11px;
            color: root.color;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

struct LicenseEntry {
    name: string,
    detail: string,
}

// One part of a "How it works" dialog. Lines of `body` starting with "• " read as a list.
struct InfoSection {
    heading: string,
    body: string,
}

// A settings card's "How it works": its icon and title, then short sections, on a card
// centered over the dimmed window. Got it, ✕, Esc or a click outside closes it; the sections
// scroll when the window is too short for them.
component InfoDialog inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <[InfoSection]> sections;
    callback close;

    // Everything but the sections: title bar, its divider and the footer.
    private property <length> chrome: 57px + footer.preferred-height;

    background: #00000080;
    accessible-role: groupbox;
    accessible-label: root.title;

    // Clicks outside the card close it; nothing reaches the window below.
    TouchArea {
        clicked => { root.close(); }
        scroll-event(e) => { accept }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
    }
    init => { keys.focus(); }

    card := Rectangle {
        width: min(520px, root.width - 32px);
        height: min(root.chrome + body.preferred-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Ui.card;
        border-radius: 16px;
        border-width: 1px;
        border-color: Ui.card-border;
        clip: true;

        // Clicks on the card itself don't close it.
        TouchArea { }

        VerticalLayout {
            // ---- title bar
            Rectangle {
                height: 56px;
                background: Palette.control-background;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: Ui.tint;
                            Icon {
                                glyph: root.glyph;
                                color: Palette.accent-background;
                                font-size: 16px;
                            }
                        }
                    }
                    Text {
                        text: root.title;
                        font-size: 16px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        GlyphButton {
                            glyph: Glyph.cancel;
                            accessible-label: "Close";
                            clicked => { root.close(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Ui.card-border;
            }

            // ---- the sections
            ScrollView {
                vertical-stretch: 1;
                body := VerticalLayout {
                    alignment: start;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 18px;
                    padding-bottom: 6px;
                    spacing: 16px;
                    for section in root.sections: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: section.heading;
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        Text {
                            text: section.body;
                            font-size: 13px;
                            color: Ui.secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ---- footer
            footer := HorizontalLayout {
                alignment: end;
                padding: 16px;
                padding-top: 10px;
                GlyphButton {
                    text: "Got it";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// The About dialog: a card centered over the dimmed window, with a Licenses view. Clicking
// outside it or pressing Esc closes it (Esc on the Licenses view goes back first).
component AboutDialog inherits Rectangle {
    in property <string> version;
    in property <string> build;
    callback check-updates;
    callback open-website;
    callback open-source;
    callback close;

    // Showing the Licenses view.
    in-out property <bool> licenses;
    property <[LicenseEntry]> components: [
        { name: "mozjpeg", detail: "JPEG encoder · IJG, BSD-3-Clause and zlib licenses" },
        { name: "libwebp", detail: "WebP encoder · BSD-3-Clause" },
        { name: "rav1e, ravif", detail: "AVIF encoder · BSD-2-Clause, BSD-3-Clause" },
        { name: "rav1d, avif-decode", detail: "AVIF decoder · BSD-2-Clause, BSD-3-Clause; avif-parse · MPL-2.0" },
        { name: "oxipng", detail: "PNG optimizer · MIT" },
        { name: "image", detail: "Image decoding · MIT or Apache-2.0" },
        { name: "moxcms", detail: "Color management · BSD-3-Clause or Apache-2.0" },
        { name: "Rust crates", detail: "rayon, rfd, serde, walkdir and others · MIT, Apache-2.0 or similar permissive licenses" },
    ];

    background: #00000080;

    // Clicks outside the card close it; nothing reaches the window below.
    TouchArea {
        clicked => { root.close(); }
        scroll-event(e) => { accept }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.licenses) {
                    root.licenses = false;
                } else {
                    root.close();
                }
                return accept;
            }
            reject
        }
    }
    init => { keys.focus(); }

    card := Rectangle {
        width: min(root.licenses ? 560px : 480px, root.width - 32px);
        height: min(content.preferred-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Ui.card;
        border-radius: 16px;
        border-width: 1px;
        border-color: Ui.card-border;
        clip: true;

        // Clicks on the card itself don't close it.
        TouchArea { }

        content := VerticalLayout {
            // ---- the app: logo, name and version, then what can be done from here
            if !root.licenses: VerticalLayout {
                padding-left: 24px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 20px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        padding-top: 8px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 16px;
                            background: Palette.control-background;
                            Image {
                                source: @image-url("../res/gravingine-logo.svg");
                                width: 44px;
                                height: 44px;
                                accessible-role: image;
                                accessible-label: "Gravingine logo";
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        padding-top: 8px;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Gravingine Image Optimizer";
                            font-size: 18px;
                            font-weight: 600;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Version " + root.version + " · build " + root.build;
                            font-size: 12px;
                            color: Ui.secondary;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        GlyphButton {
                            glyph: Glyph.cancel;
                            accessible-label: "Close";
                            clicked => { root.close(); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    GlyphButton {
                        text: "Check for updates";
                        primary: true;
                        clicked => { root.check-updates(); }
                    }
                    GlyphButton {
                        text: "Licenses";
                        clicked => { root.licenses = true; }
                    }
                    GlyphButton {
                        glyph: Glyph.open-new;
                        text: "Source code";
                        clicked => { root.open-source(); }
                    }
                }
            }

            // ---- the maker
            if !root.licenses: Rectangle {
                height: 1px;
                background: Ui.card-border;
            }
            if !root.licenses: Rectangle {
                background: Palette.background;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../res/gravitide-icon.svg");
                            width: 32px;
                            height: 32px;
                            accessible-role: image;
                            accessible-label: "Gravitide logo";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Made by Gravitide";
                            font-size: 13px;
                            color: Palette.foreground;
                        }
                        Text {
                            text: "© 2026 Gravitide Pvt Ltd · MIT license";
                            font-size: 12px;
                            color: Ui.secondary;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Link {
                            text: "gravitide.dev";
                            clicked => { root.open-website(); }
                        }
                    }
                }
            }

            // ---- the Licenses view's title bar
            if root.licenses: Rectangle {
                height: 56px;
                background: Palette.control-background;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        GlyphButton {
                            glyph: Glyph.chevron-left;
                            accessible-label: "Back";
                            clicked => { root.licenses = false; }
                        }
                    }
                    Text {
                        text: "Licenses";
                        font-size: 16px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        GlyphButton {
                            glyph: Glyph.cancel;
                            accessible-label: "Close";
                            clicked => { root.close(); }
                        }
                    }
                }
            }
            if root.licenses: Rectangle {
                height: 1px;
                background: Ui.card-border;
            }

            // ---- licenses
            if root.licenses: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 16px;
                    AboutSlint {
                        horizontal-stretch: 0;
                        max-width: 190px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Slint";
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        Text {
                            text: "User interface toolkit · Slint Royalty-free License 2.0";
                            font-size: 12px;
                            color: Ui.secondary;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Ui.card-border;
                }
                for entry in root.components: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: entry.name;
                        width: 128px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text {
                        text: entry.detail;
                        font-size: 12px;
                        color: Ui.secondary;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Ui.card-border;
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Gravingine Image Optimizer is MIT licensed. The full license texts are in each project's repository.";
                            font-size: 12px;
                            color: Ui.secondary;
                            wrap: word-wrap;
                        }
                    }
                    Link {
                        text: "Source code";
                        clicked => { root.open-source(); }
                    }
                }
            }
        }
    }
}

// "Save as preset": name the current settings. Enter saves, Esc or a click outside cancels.
component PresetDialog inherits Rectangle {
    // What will be saved ("WebP at 80% · HD (1920 × 1080)").
    in property <string> summary;
    in property <string> error;
    callback save(string);
    callback close;

    background: #00000080;

    TouchArea {
        clicked => { root.close(); }
        scroll-event(e) => { accept }
    }

    card := Rectangle {
        width: min(420px, root.width - 32px);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Ui.card;
        border-radius: 16px;
        border-width: 1px;
        border-color: Ui.card-border;

        TouchArea { }

        keys := FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }

            content := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "Save as preset";
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                Text {
                    text: "Saves the output formats, their quality and resizing: " + root.summary;
                    font-size: 12px;
                    color: Ui.secondary;
                    wrap: word-wrap;
                }
                name := LineEdit {
                    placeholder-text: "Preset name";
                    accepted(text) => { root.save(text); }
                }
                if root.error != "": Text {
                    text: root.error;
                    font-size: 12px;
                    color: Ui.critical;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GlyphButton {
                        text: "Cancel";
                        clicked => { root.close(); }
                    }
                    GlyphButton {
                        text: "Save";
                        primary: true;
                        enabled: name.text != "";
                        clicked => { root.save(name.text); }
                    }
                }
            }
        }
    }

    init => { name.focus(); }
}

export component AppWindow inherits Window {
    title: "Gravingine Image Optimizer";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;
    background: Palette.background;
    default-font-size: 13px;

    // ---- settings (read and written by Rust)
    in-out property <bool> webp;
    in-out property <float> webp-quality: 80;
    in-out property <bool> webp-lossless;
    in-out property <bool> avif;
    in-out property <float> avif-quality: 60;
    in-out property <float> avif-speed: 6;
    in-out property <bool> jpeg;
    in-out property <float> jpeg-quality: 80;
    in-out property <bool> png;
    in-out property <float> png-level: 2;
    in-out property <bool> resize;
    in-out property <int> resize-mode;
    // The resize dropdown (labels from Rust), and which entries show the custom fields.
    in property <[string]> resize-options;
    in property <int> resize-custom-size;
    in property <int> resize-custom-percent;
    in-out property <string> limit-width;
    in-out property <string> limit-height;
    in-out property <string> percent;
    in-out property <int> save-mode;
    in-out property <string> output-dir;
    in-out property <bool> skip-larger: true;
    in-out property <bool> overwrite;
    in-out property <bool> clear-when-done;
    // Target file size: on/off, the value and its unit (0 KB, 1 MB).
    in-out property <bool> target-size;
    in-out property <string> target-value: "200";
    in-out property <int> target-unit;
    // Color profile: 0 keep, 1 convert to sRGB. Metadata: 0 remove all, 1 keep except the
    // location, 2 keep all.
    in-out property <int> color-profile;
    in-out property <int> metadata-mode;
    // The "How it works" dialog showing: 0 none, 1 target file size, 2 color profile and
    // metadata.
    in-out property <int> info-topic;
    property <[InfoSection]> target-info: [
        {
            heading: "What it does",
            body: "Each JPEG, WebP and AVIF file is made as good as it can be while staying under the size you set. The quality is picked for every image on its own, so the quality sliders are set aside while this is on.",
        },
        {
            heading: "How the quality is picked",
            body: "It tries 100% first. If that's too big, it narrows down to the highest quality that fits, to within 2 points, going no lower than 10%. Tiles and the preview show the quality picked, like \"WebP at 71%\".",
        },
        {
            heading: "With other settings",
            body: "• With Skip files larger than the original on, it also stays smaller than the original, so nothing gets thrown away.\n• Kept metadata counts toward the size.\n• PNG and lossless WebP aren't changed: they have no quality to lower.",
        },
        {
            heading: "When it can't fit",
            body: "If even 10% is too big, the image is still saved, at its smallest, and marked in amber. Clear images from the list once optimized leaves it in the list so you can look at it.",
        },
    ];
    property <[InfoSection]> color-info: [
        {
            heading: "Color profiles",
            body: "A color profile says which colors an image's numbers stand for. Most images are sRGB, the web's default. Photos from recent phones and cameras are often Display P3 or Adobe RGB, which reach more saturated colors. Thumbnails and the preview show colors correctly either way.",
        },
        {
            heading: "Keep",
            body: "Wide-gamut photos keep their profile, so they look like the original. JPEG, WebP and PNG carry it in the file. An sRGB profile is left out, since sRGB is the default anyway. AVIF files can't carry one here, so they're converted to sRGB.",
        },
        {
            heading: "Convert to sRGB",
            body: "The colors are converted to sRGB and no profile is saved: the same colors in every app, and slightly smaller files. Colors outside sRGB are pulled in, so wide-gamut photos lose a little saturation.",
        },
        {
            heading: "Metadata",
            body: "• Remove all: nothing about the camera, author, date or location is kept. The smallest files.\n• Keep, except location: camera, lens, exposure settings, date taken, author, copyright and description.\n• Keep all: all of that and the location (GPS), so anyone with the file can see where it was taken.",
        },
        {
            heading: "Always left out",
            body: "Maker notes (the camera maker's private data, often tens of KB), the embedded thumbnail, and XMP and IPTC data. The profile and metadata of AVIF originals aren't read.",
        },
        {
            heading: "Orientation",
            body: "Photos come out upright: the camera's orientation is applied to the pixels, so it isn't saved in the file.",
        },
    ];
    // How far the settings pane is scrolled (negative, as Slint keeps it).
    in-out property <length> settings-scroll;

    // ---- state (written by Rust)
    in property <[TileData]> tiles;
    in property <bool> running;
    in property <bool> drag-hover;
    in property <string> status: "Add images to get started.";
    in property <float> progress;
    in property <string> optimize-label: "Optimize";
    in property <bool> can-optimize;
    in property <bool> can-clear;
    in property <bool> can-select-all;
    in property <bool> can-select-none;
    in property <bool> has-output;
    in property <string> resize-hint;

    // ---- before / after comparison (written by Rust)
    in property <bool> compare-open;
    in property <string> compare-name;
    in property <[CompareFormat]> compare-formats;
    in property <int> compare-current;
    in property <image> compare-original;
    in property <image> compare-output;
    in property <int> compare-width;
    in property <int> compare-height;
    in property <string> compare-output-label;
    in property <string> compare-original-size;
    in property <string> compare-original-dims;
    in property <string> compare-output-caption;
    in property <string> compare-output-size;
    in property <string> compare-output-dims;
    in property <string> compare-saving;
    in property <string> compare-saving-detail;
    in property <string> compare-busy;
    in property <int> compare-output-tone;
    in property <bool> compare-preview;
    in property <bool> compare-has-saved;
    in property <string> compare-message;
    in-out property <float> compare-zoom;
    in-out property <float> compare-split: 0.5;
    callback compare(int);
    callback compare-select(int);
    callback compare-mode(bool);

    // ---- about
    in property <string> app-version;
    in property <string> app-build;
    in-out property <bool> about-open;
    in-out property <bool> about-licenses;
    callback open-source;
    callback open-releases;
    callback open-website;

    // ---- presets (names, current choice and summary written by Rust)
    in property <[string]> preset-names;
    in-out property <int> preset-index;
    in property <string> preset-summary;
    // The current preset is one of the user's own (so it can be deleted).
    in property <bool> preset-deletable;
    in-out property <bool> preset-dialog-open;
    in-out property <string> preset-error;
    callback apply-preset(int);
    callback save-preset(string);
    callback delete-preset;
    callback compare-close;

    callback add-files;
    callback add-folder;
    callback clear-all;
    callback select-all;
    callback select-none;
    callback browse;
    callback optimize;
    callback cancel;
    callback open-output;
    callback settings-changed;
    callback tile-toggled(int, bool);

    // Force light or dark instead of following Windows (testing).
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    private property <bool> idle: !root.running;

    HorizontalLayout {
        padding: 16px;
        padding-bottom: 0px;
        spacing: 20px;

        // ------------------------------------------------ left: toolbar and settings
        VerticalLayout {
            width: 330px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                GlyphButton {
                    glyph: Glyph.add-files;
                    text: "Add files…";
                    enabled: root.idle;
                    clicked => { root.add-files(); }
                }
                GlyphButton {
                    glyph: Glyph.add-folder;
                    text: "Add folder…";
                    enabled: root.idle;
                    clicked => { root.add-folder(); }
                }
                GlyphButton {
                    glyph: Glyph.clear;
                    text: "Clear";
                    enabled: root.can-clear;
                    clicked => { root.clear-all(); }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-y <=> root.settings-scroll;
                VerticalLayout {
                    // Stack from the top: extra height stays empty instead of stretching the cards.
                    alignment: start;
                    padding-right: 14px;
                    padding-bottom: 16px;
                    spacing: 8px;

                    SectionHeading { text: "Preset"; }
                    // Preset: pick one to set formats, quality and resizing in one go; "Custom"
                    // when the settings don't match any.
                    Rectangle {
                        background: Ui.card;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Ui.card-border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 9px;
                                        background: Ui.tint;
                                        Icon {
                                            glyph: Glyph.preset;
                                            color: Palette.accent-background;
                                            font-size: 18px;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    DropDown {
                                        model: root.preset-names;
                                        current-index <=> root.preset-index;
                                        enabled: root.idle;
                                        selected => { root.apply-preset(self.current-index); }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-left: 48px;
                                spacing: 8px;
                                Text {
                                    text: root.preset-summary;
                                    font-size: 12px;
                                    color: Ui.secondary;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    GlyphButton {
                                        glyph: Glyph.save;
                                        text: "Save as preset…";
                                        enabled: root.idle;
                                        clicked => {
                                            root.preset-error = "";
                                            root.preset-dialog-open = true;
                                        }
                                    }
                                    if root.preset-deletable: GlyphButton {
                                        glyph: Glyph.clear;
                                        enabled: root.idle;
                                        accessible-label: "Delete this preset";
                                        clicked => { root.delete-preset(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 4px; }
                    SectionHeading { text: "Output formats"; }
                    SettingCard {
                        glyph: Glyph.webp;
                        title: "WebP";
                        description: "Small files, keeps transparency";
                        enabled: root.idle;
                        on <=> root.webp;
                        toggled => { root.settings-changed(); }
                        SliderRow {
                            label: "Quality";
                            unit: "%";
                            minimum: 1;
                            maximum: 100;
                            value <=> root.webp-quality;
                            enabled: root.idle && !root.webp-lossless && !root.target-size;
                            changed => { root.settings-changed(); }
                        }
                        SwitchRow {
                            label: "Lossless";
                            checked <=> root.webp-lossless;
                            enabled: root.idle;
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingCard {
                        glyph: Glyph.avif;
                        title: "AVIF";
                        description: "Smallest files, slower to encode";
                        enabled: root.idle;
                        on <=> root.avif;
                        toggled => { root.settings-changed(); }
                        SliderRow {
                            label: "Quality";
                            unit: "%";
                            minimum: 1;
                            maximum: 100;
                            value <=> root.avif-quality;
                            enabled: root.idle && !root.target-size;
                            changed => { root.settings-changed(); }
                        }
                        SliderRow {
                            label: "Speed";
                            minimum: 1;
                            maximum: 10;
                            value <=> root.avif-speed;
                            enabled: root.idle;
                            changed => { root.settings-changed(); }
                        }
                    }
                    SettingCard {
                        glyph: Glyph.jpeg;
                        title: "JPEG";
                        description: "Works everywhere";
                        enabled: root.idle;
                        on <=> root.jpeg;
                        toggled => { root.settings-changed(); }
                        SliderRow {
                            label: "Quality";
                            unit: "%";
                            minimum: 1;
                            maximum: 100;
                            value <=> root.jpeg-quality;
                            enabled: root.idle && !root.target-size;
                            changed => { root.settings-changed(); }
                        }
                    }
                    SettingCard {
                        glyph: Glyph.png;
                        title: "PNG";
                        description: "Lossless, for logos and icons";
                        enabled: root.idle;
                        on <=> root.png;
                        toggled => { root.settings-changed(); }
                        SliderRow {
                            label: "Effort";
                            minimum: 0;
                            maximum: 6;
                            value <=> root.png-level;
                            enabled: root.idle;
                            changed => { root.settings-changed(); }
                        }
                    }

                    Rectangle { height: 4px; }
                    SectionHeading { text: "Image size"; }
                    SettingCard {
                        glyph: Glyph.resize;
                        title: "Resize images";
                        description: "Shrinks large images";
                        enabled: root.idle;
                        on <=> root.resize;
                        toggled => { root.settings-changed(); }
                        DropDown {
                            model: root.resize-options;
                            current-index <=> root.resize-mode;
                            enabled: root.idle;
                            selected => { root.settings-changed(); }
                        }
                        if root.resize-mode == root.resize-custom-size: NumberRow {
                            label: "Max width (px)";
                            value <=> root.limit-width;
                            enabled: root.idle;
                            edited => { root.settings-changed(); }
                        }
                        if root.resize-mode == root.resize-custom-size: NumberRow {
                            label: "Max height (px)";
                            value <=> root.limit-height;
                            enabled: root.idle;
                            edited => { root.settings-changed(); }
                        }
                        if root.resize-mode == root.resize-custom-percent: NumberRow {
                            label: "Percent";
                            value <=> root.percent;
                            enabled: root.idle;
                            edited => { root.settings-changed(); }
                        }
                        if root.resize-hint != "": Hint {
                            text: root.resize-hint;
                        }
                    }
                    SettingCard {
                        glyph: Glyph.target;
                        title: "Target file size";
                        description: "Caps file sizes";
                        more: "How it works";
                        more-clicked => { root.info-topic = 1; }
                        enabled: root.idle;
                        on <=> root.target-size;
                        toggled => { root.settings-changed(); }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Keep each file under";
                                vertical-alignment: center;
                                color: root.idle ? Palette.foreground : Ui.tertiary;
                            }
                            LineEdit {
                                width: 76px;
                                text <=> root.target-value;
                                enabled: root.idle;
                                input-type: number;
                                horizontal-alignment: right;
                                edited => { root.settings-changed(); }
                            }
                            DropDown {
                                width: 78px;
                                model: ["KB", "MB"];
                                current-index <=> root.target-unit;
                                enabled: root.idle;
                                selected => { root.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { height: 4px; }
                    SectionHeading { text: "Save to"; }
                    SettingCard {
                        glyph: Glyph.save;
                        title: "Output folder";
                        switchable: false;
                        DropDown {
                            model: ["\"optimized\" folder next to images", "Custom folder"];
                            current-index <=> root.save-mode;
                            enabled: root.idle;
                            selected => {
                                if (root.save-mode == 1 && root.output-dir == "") {
                                    root.browse();
                                }
                                root.settings-changed();
                            }
                        }
                        if root.save-mode == 1: HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                text <=> root.output-dir;
                                placeholder-text: "Choose a folder";
                                enabled: root.idle;
                                edited => { root.settings-changed(); }
                            }
                            GlyphButton {
                                glyph: Glyph.browse;
                                enabled: root.idle;
                                accessible-label: "Browse";
                                clicked => { root.browse(); }
                            }
                        }
                        CheckBox {
                            text: "Skip files larger than the original";
                            checked <=> root.skip-larger;
                            enabled: root.idle;
                            toggled => { root.settings-changed(); }
                        }
                        CheckBox {
                            text: "Overwrite existing files";
                            checked <=> root.overwrite;
                            enabled: root.idle;
                            toggled => { root.settings-changed(); }
                        }
                        CheckBox {
                            text: "Clear images from the list once optimized";
                            checked <=> root.clear-when-done;
                            enabled: root.idle;
                            toggled => { root.settings-changed(); }
                        }
                    }

                    Rectangle { height: 4px; }
                    SectionHeading { text: "Advanced settings"; }
                    SettingCard {
                        glyph: Glyph.tag;
                        title: "Color profile and metadata";
                        description: "Profiles, EXIF and location";
                        more: "How it works";
                        more-clicked => { root.info-topic = 2; }
                        switchable: false;
                        ChoiceRow {
                            label: "Color profile";
                            model: ["Keep", "Convert to sRGB"];
                            current-index <=> root.color-profile;
                            enabled: root.idle;
                            selected => { root.settings-changed(); }
                        }
                        ChoiceRow {
                            label: "Metadata";
                            model: ["Remove all", "Keep, except location", "Keep all"];
                            current-index <=> root.metadata-mode;
                            enabled: root.idle;
                            selected => { root.settings-changed(); }
                        }
                        // Kept location is a privacy matter: said right here, not behind a link.
                        if root.metadata-mode == 2: Hint {
                            text: "The location (GPS) is kept: anyone with the file can see it.";
                            warning: true;
                        }
                    }
                }
            }
        }

        // ------------------------------------------------ right: list and footer
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                GlyphButton {
                    glyph: Glyph.select-all;
                    text: "Select all";
                    enabled: root.can-select-all;
                    clicked => { root.select-all(); }
                }
                GlyphButton {
                    glyph: Glyph.select-none;
                    text: "Select none";
                    enabled: root.can-select-none;
                    clicked => { root.select-none(); }
                }
                Rectangle { horizontal-stretch: 1; }
                GlyphButton {
                    glyph: Glyph.info;
                    text: "About";
                    clicked => {
                        root.about-licenses = false;
                        root.about-open = true;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 14px;
                background: Ui.card;
                border-width: root.drag-hover ? 2px : 1px;
                border-color: root.drag-hover ? Palette.accent-background : Ui.card-border;
                clip: true;

                if root.tiles.length > 0: ListView {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    for tile[i] in root.tiles: Tile {
                        data: tile;
                        enabled: root.idle;
                        toggled(on) => { root.tile-toggled(i, on); }
                        compare => { root.compare(i); }
                    }
                }

                if root.tiles.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        glyph: Glyph.drop;
                        font-size: 48px;
                        color: Palette.accent-background;
                        height: 64px;
                    }
                    Text {
                        text: root.drag-hover ? "Release to add images" : "Drop images or folders here";
                        font-size: 20px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: Palette.foreground;
                    }
                    Text {
                        text: "or use Add files… or Add folder…";
                        horizontal-alignment: center;
                        color: Ui.secondary;
                    }
                    Text {
                        text: "JPG · PNG · WebP · AVIF · GIF · BMP · TIFF · ICO";
                        horizontal-alignment: center;
                        font-size: 12px;
                        color: Ui.tertiary;
                    }
                }

                // Before / after comparison, over the list.
                if root.compare-open: CompareView {
                    name: root.compare-name;
                    formats: root.compare-formats;
                    current: root.compare-current;
                    original: root.compare-original;
                    output: root.compare-output;
                    image-width: root.compare-width;
                    image-height: root.compare-height;
                    output-label: root.compare-output-label;
                    original-size: root.compare-original-size;
                    original-dims: root.compare-original-dims;
                    output-caption: root.compare-output-caption;
                    output-size: root.compare-output-size;
                    output-dims: root.compare-output-dims;
                    saving: root.compare-saving;
                    saving-detail: root.compare-saving-detail;
                    busy: root.compare-busy;
                    output-tone: root.compare-output-tone;
                    preview: root.compare-preview;
                    has-saved: root.compare-has-saved;
                    message: root.compare-message;
                    zoom <=> root.compare-zoom;
                    split <=> root.compare-split;
                    select(i) => { root.compare-select(i); }
                    set-preview(on) => { root.compare-mode(on); }
                    close => { root.compare-close(); }
                }
            }

            // Footer: Optimize / Cancel, status and progress, Open output folder.
            HorizontalLayout {
                height: 60px;
                spacing: 14px;
                padding-bottom: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    if root.idle: GlyphButton {
                        glyph: Glyph.optimize;
                        text: root.optimize-label;
                        primary: true;
                        enabled: root.can-optimize;
                        clicked => { root.optimize(); }
                    }
                    if root.running: GlyphButton {
                        glyph: Glyph.cancel;
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.status;
                        color: Palette.foreground;
                        overflow: elide;
                    }
                    if root.running: ProgressIndicator {
                        width: 220px;
                        height: 4px;
                        progress: root.progress;
                    }
                }
                if root.idle && root.has-output: VerticalLayout {
                    alignment: center;
                    GlyphButton {
                        glyph: Glyph.open-folder;
                        text: "Open output folder";
                        clicked => { root.open-output(); }
                    }
                }
            }
        }
    }

    if root.about-open: AboutDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        version: root.app-version;
        build: root.app-build;
        licenses <=> root.about-licenses;
        check-updates => { root.open-releases(); }
        open-website => { root.open-website(); }
        open-source => { root.open-source(); }
        close => { root.about-open = false; }
    }

    if root.info-topic != 0: InfoDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        glyph: root.info-topic == 1 ? Glyph.target : Glyph.tag;
        title: root.info-topic == 1 ? "Target file size" : "Color profile and metadata";
        sections: root.info-topic == 1 ? root.target-info : root.color-info;
        close => { root.info-topic = 0; }
    }

    if root.preset-dialog-open: PresetDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        summary: root.preset-summary;
        error: root.preset-error;
        save(name) => { root.save-preset(name); }
        close => { root.preset-dialog-open = false; }
    }
}
